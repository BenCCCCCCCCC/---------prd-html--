{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netease-demo:intent:0.5",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "ready",
        "needs_clarification",
        "unsupported"
      ]
    },
    "patch": {
      "type": "object",
      "properties": {
        "freshness": {
          "anyOf": [
            {
              "enum": [
                "familiar",
                "balanced",
                "explore"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "positiveTagIds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "enum": [
                  "genre_folk",
                  "genre_pop",
                  "genre_rock",
                  "genre_classical",
                  "mood_calm",
                  "mood_sad",
                  "mood_energetic",
                  "scene_study",
                  "scene_exercise",
                  "lang_zh",
                  "lang_en",
                  "theme_instrumental"
                ]
              },
              "maxItems": 3,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "negativeTargets": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "track"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^T(0[1-9]|1[0-9]|2[0-4])$"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "artist"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^A0[1-8]$"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "tag"
                      },
                      "id": {
                        "enum": [
                          "genre_folk",
                          "genre_pop",
                          "genre_rock",
                          "genre_classical",
                          "mood_calm",
                          "mood_sad",
                          "mood_energetic",
                          "scene_study",
                          "scene_exercise",
                          "lang_zh",
                          "lang_en",
                          "theme_instrumental"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "maxItems": 3,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "freshness",
        "positiveTagIds",
        "negativeTargets"
      ],
      "additionalProperties": false
    },
    "scopeSuggestion": {
      "anyOf": [
        {
          "enum": [
            "session",
            "long_term"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "isolationSuggestion": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "unmappedPhrases": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      },
      "maxItems": 8
    },
    "clarificationQuestion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "patch",
    "scopeSuggestion",
    "isolationSuggestion",
    "unmappedPhrases",
    "clarificationQuestion"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "unmappedPhrases": {
            "maxItems": 0
          },
          "clarificationQuestion": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs_clarification",
              "unsupported"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "patch": {
            "type": "object",
            "properties": {
              "freshness": {
                "type": "null"
              },
              "positiveTagIds": {
                "type": "null"
              },
              "negativeTargets": {
                "type": "null"
              }
            },
            "required": [
              "freshness",
              "positiveTagIds",
              "negativeTargets"
            ],
            "additionalProperties": false
          },
          "scopeSuggestion": {
            "type": "null"
          },
          "isolationSuggestion": {
            "type": "null"
          },
          "clarificationQuestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  ]
}

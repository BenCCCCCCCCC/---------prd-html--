{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netease-demo:intent-request:0.5",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "draftRevision": {
      "type": "integer",
      "minimum": 0
    },
    "inputText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "currentTrackId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^T(0[1-9]|1[0-9]|2[0-4])$"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentArtistId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^A0[1-8]$"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentStyleIds": {
      "type": "array",
      "items": {
        "enum": [
          "genre_folk",
          "genre_pop",
          "genre_rock",
          "genre_classical"
        ]
      },
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "required": [
    "requestId",
    "draftRevision",
    "inputText",
    "currentTrackId",
    "currentArtistId",
    "currentStyleIds"
  ],
  "additionalProperties": false
}
